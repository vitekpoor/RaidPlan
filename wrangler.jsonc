{
  // Cloudflare Worker "eternal-shadows": serves the built site (repo root) as static
  // assets and a JSON API (worker/index.js) backed by the D1 database "eternal-shadows".
  // Deployed by Cloudflare's GitHub integration with `npx wrangler deploy`; the name
  // below must match the Worker name in the dashboard. Files listed in .assetsignore
  // (sources, tools, git metadata, worker/) are not uploaded as assets.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eternal-shadows",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Plain vars (secrets API_TOKEN / GITHUB_TOKEN / RUN_PASSWORD live only in the dashboard). Vars set in the dashboard
  // are replaced on every deploy, so keep them here.
  "vars": {
    "DISCORD_SIM_CHANNEL": "1549744240370782260"   // shared Discord channel (id) for sim notifications of players without a room
  },
  // worker/migrations/*.sql are imported as text modules (POST /api/admin/migrate runs them)
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eternal-shadows",
      "database_id": "b755462b-aa07-4b94-8fd2-ef3a9f0d2c94",
      "migrations_dir": "worker/migrations"
    }
  ]
}
