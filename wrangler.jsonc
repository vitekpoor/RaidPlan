{
  // Cloudflare Worker "eternal-shadows": serves the site built from web/ into dist/ (build.command runs on
  // Cloudflare before every deploy – nothing generated is committed) plus a JSON API (worker/index.js) backed
  // by the D1 database "eternal-shadows". Deployed by Cloudflare's GitHub integration with `npx wrangler deploy`;
  // the name below must match the Worker name in the dashboard.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eternal-shadows",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-18",
  "build": { "command": "node web/build.mjs", "watch_dir": "web" },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Daily absence report to Discord at 18:00 Europe/Prague (worker/raidtime.js scheduled): cron is UTC-only, so it fires
  // at 16:00 and 17:00 UTC and the handler keeps the firing that is 18:xx in Prague (summer = 16 UTC, winter = 17 UTC).
  "triggers": { "crons": ["0 16 * * *", "0 17 * * *"] },
  // Plain vars (secrets API_TOKEN / GITHUB_TOKEN / RUN_PASSWORD live only in the dashboard). Vars set in the dashboard
  // are replaced on every deploy, so keep them here.
  "vars": {
    "DISCORD_ABSENCE_CHANNEL": "1545064822192738465",
    "DISCORD_ABSENCE_WEBHOOK": "https://discord.com/api/webhooks/1545064867612860447/68KvTnVQwVZyddmpl6qjn4Ah33jh6Ud6eCCx2AnNkiHzFszDFbLwBqoLQgT0sfjUYZJk",
    "DISCORD_ANNOUNCE_CHANNEL": "1342560916369313965",
    "DISCORD_ANNOUNCE_WEBHOOK": "https://discord.com/api/webhooks/1556661494274592769/m5oXsQ0m4Iuyq1iJu7pKuFQPsve9zQZ6az8oCzGj9QV6dcMW4bejXCh1d3l-WCbprbvj",
    "DISCORD_GUILD_ID": "1336363121660657717",
    "DISCORD_SIM_CHANNEL": "1549744240370782260",
    "WCL_CLIENT_ID": "01a0b464-cd4e-7149-9abb-0a0888814556"
  },
  // worker/migrations/*.sql are imported as text modules (POST /api/admin/migrate runs them)
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eternal-shadows",
      "database_id": "b755462b-aa07-4b94-8fd2-ef3a9f0d2c94",
      "migrations_dir": "worker/migrations"
    }
  ]
}
